# ─── ASIS Environment Variables ───────────────────────────────────────────────
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://asis:asis@localhost:5432/asis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Anthropic API (REQUIRED) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── MCP / External APIs ───────────────────────────────────────────────────────
# Tavily — web search (https://tavily.com)
TAVILY_API_KEY=tvly-...

# Financial Modeling Prep — financial data (https://financialmodelingprep.com)
FMP_API_KEY=...

# NewsAPI — news context (https://newsapi.org)
NEWSAPI_KEY=...

# Google Drive — internal documents (optional, path to service-account JSON)
GOOGLE_DRIVE_CREDENTIALS=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ALLOWED_ORIGINS=http://localhost:3000
