# ─────────────────────────────────────────────────────────────────────────────
# ASIS v3.0 — Environment Variables Reference
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────

# Deployment environment: development | staging | production
ENVIRONMENT=development

# ── LLM Providers ────────────────────────────────────────────────────────────

# Anthropic API key — used by LiteLLM to call Claude models (REQUIRED)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key — used by LiteLLM for text-embedding-3-small (REQUIRED for embeddings)
# Get yours at: https://platform.openai.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Auth ──────────────────────────────────────────────────────────────────────

# JWT signing secret — must be at least 32 characters (REQUIRED)
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# ── Databases ────────────────────────────────────────────────────────────────

# PostgreSQL async connection string (REQUIRED)
# Local dev default: postgresql+asyncpg://asis:asis@localhost:5432/asis
DATABASE_URL=postgresql+asyncpg://asis:asis@localhost:5432/asis

# Redis connection URL — used for caching, rate limiting, Celery broker
# Local dev default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ── LiteLLM Proxy ────────────────────────────────────────────────────────────

# Base URL of the LiteLLM proxy server
# Local dev default: http://localhost:4000
LITELLM_PROXY_URL=http://localhost:4000

# LiteLLM master key — used to authenticate requests to the proxy
LITELLM_MASTER_KEY=sk-dev-master-key-change-in-production

# ── Vector Store ─────────────────────────────────────────────────────────────

# Qdrant vector database URL
# Local dev default: http://localhost:6333
QDRANT_URL=http://localhost:6333

# Qdrant API key — leave blank for unauthenticated local instance
QDRANT_API_KEY=

# ── Memory ───────────────────────────────────────────────────────────────────

# Mem0 API key — for persistent multi-session memory
# Get yours at: https://app.mem0.ai
MEM0_API_KEY=m0-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mem0 base URL — leave blank to use the default cloud endpoint
MEM0_BASE_URL=https://api.mem0.ai

# ── Observability (Langfuse) ──────────────────────────────────────────────────

# Langfuse public key — used to send traces to Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Langfuse secret key — server-side only, never expose to the frontend
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Langfuse host — local dev uses the bundled Langfuse container on port 3001
LANGFUSE_HOST=http://localhost:3001

# ── Data Sources ─────────────────────────────────────────────────────────────

# Tavily AI web search API key — used by Market Intelligence and Risk agents
# Get yours at: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Financial Modeling Prep API key — used by the Financial Reasoning agent
# Get yours at: https://financialmodelingprep.com
FMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NewsAPI key — used for news context in Market Intelligence and Risk agents
# Get yours at: https://newsapi.org
NEWSAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Workflow Automation (n8n) ─────────────────────────────────────────────────

# Shared secret for verifying n8n webhook payloads — must match n8n config
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret

# ── Celery Task Queue ─────────────────────────────────────────────────────────

# Celery broker URL — Redis database 1 (separate from cache on db 0)
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend — Redis database 2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Google Cloud Platform ────────────────────────────────────────────────────

# GCP project ID — used for Secret Manager and Cloud Run deployments
GCP_PROJECT_ID=your-gcp-project-id

# GCP region — primary deployment region
GCP_REGION=asia-south1
