{
  "name": "ASIS WF01 — Scheduled Intelligence Run",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "company_name",
              "name": "company_name",
              "value": "={{ $env.ASIS_DEFAULT_COMPANY }}",
              "type": "string"
            },
            {
              "id": "sector",
              "name": "sector",
              "value": "={{ $env.ASIS_DEFAULT_SECTOR }}",
              "type": "string"
            },
            {
              "id": "geography",
              "name": "geography",
              "value": "={{ $env.ASIS_DEFAULT_GEOGRAPHY }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-context",
      "name": "Set Company Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build the exact JSON body and compute HMAC over it.\n// This ensures the signature matches what the backend verifies against the raw body.\nconst item = $input.item.json;\n\nconst body = {\n  workflow_id: 'WF01_scheduled_intelligence',\n  workflow_name: 'Scheduled Intelligence Run',\n  query: `Provide a comprehensive strategic intelligence briefing for ${item.company_name} covering: (1) key market developments in the past 7 days, (2) competitive landscape shifts, (3) emerging risks and opportunities, and (4) recommended strategic actions for this week.`,\n  company_context: {\n    company_name: item.company_name,\n    sector: item.sector,\n    geography: item.geography\n  },\n  options: {\n    query_type: 'full_brief',\n    enable_rag: true,\n    enable_memory: true,\n    run_baseline: false,\n    run_evaluation: true\n  },\n  tenant_id: $env.ASIS_DEFAULT_TENANT || '00000000-0000-0000-0000-000000000001',\n  callback_url: ($env.N8N_WEBHOOK_BASE_URL || '') + '/webhook/asis-completion'\n};\n\nconst bodyStr = JSON.stringify(body);\nconst secret = $env.ASIS_WEBHOOK_SECRET || '';\nconst crypto = require('crypto');\nconst sig = 'sha256=' + crypto.createHmac('sha256', secret).update(bodyStr).digest('hex');\n\nreturn [{ json: { body_str: bodyStr, signature: sig } }];"
      },
      "id": "build-request",
      "name": "Build Request + Sign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ASIS_API_URL }}/v1/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-N8N-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.body_str }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "post-to-asis",
      "name": "POST to ASIS Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-queued",
              "leftValue": "={{ $json.status }}",
              "rightValue": "queued",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-queued",
      "name": "Check Queued",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "message": "ASIS Scheduled Run Queued\n\nAnalysis ID: {{ $json.analysis_id }}\nMessage: {{ $json.message }}\nTime: {{ $now.toISOString() }}",
        "otherOptions": {}
      },
      "id": "success-log",
      "name": "Log Success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1340, 180]
    },
    {
      "parameters": {
        "message": "ASIS Scheduled Run Failed\n\nWorkflow: WF01 Scheduled Intelligence\nStatus: {{ $json.status }}\nError: {{ $json.detail || 'Unknown error' }}\nTime: {{ $now.toISOString() }}",
        "otherOptions": {}
      },
      "id": "error-log",
      "name": "Log Error",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1340, 420]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Set Company Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Company Context": {
      "main": [
        [
          {
            "node": "Build Request + Sign",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Request + Sign": {
      "main": [
        [
          {
            "node": "POST to ASIS Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST to ASIS Webhook": {
      "main": [
        [
          {
            "node": "Check Queued",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Queued": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": [
    {
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "id": "asis-scheduled",
      "name": "asis-scheduled"
    }
  ],
