        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_id\": \"WF02_enterprise_trigger\",\n  \"workflow_name\": \"Enterprise Webhook Trigger\",\n  \"query\": {{ JSON.stringify($json.body.query) }},\n  \"company_context\": {{ JSON.stringify($json.body.company_context) }},\n  \"options\": {{ JSON.stringify($json.body.options || { query_type: 'full_brief', enable_rag: true, enable_memory: true }) }},\n  \"tenant_id\": \"{{ $json.body.tenant_id || $env.ASIS_DEFAULT_TENANT }}\",\n  \"callback_url\": \"{{ $json.body.callback_url || '' }}\",\n  \"metadata\": {{ JSON.stringify($json.body.metadata || {}) }}\n}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
