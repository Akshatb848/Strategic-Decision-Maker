{
  "name": "ASIS WF04 — Human Approval Gate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "asis-approval-gate",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "approval-webhook",
      "name": "ASIS Completion Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "asis-approval-gate"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "analysis_id",
              "name": "analysis_id",
              "value": "={{ $json.body.analysis_id }}",
              "type": "string"
            },
            {
              "id": "confidence_score",
              "name": "confidence_score",
              "value": "={{ $json.body.confidence_score }}",
              "type": "number"
            },
            {
              "id": "executive_summary",
              "name": "executive_summary",
              "value": "={{ $json.body.executive_summary }}",
              "type": "string"
            },
            {
              "id": "recommendation",
              "name": "recommendation",
              "value": "={{ $json.body.recommendation }}",
              "type": "string"
            },
            {
              "id": "report_url",
              "name": "report_url",
              "value": "={{ $json.body.report_url }}",
              "type": "string"
            },
            {
              "id": "tenant_id",
              "name": "tenant_id",
              "value": "={{ $json.body.tenant_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-fields",
      "name": "Extract Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "confidence-check",
              "leftValue": "={{ $json.confidence_score }}",
              "rightValue": 8.5,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-confidence",
      "name": "Confidence > 8.5?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $env.SLACK_APPROVAL_CHANNEL_ID }}",
          "mode": "id"
        },
        "text": ":white_check_mark: *ASIS High-Confidence Report — Auto-Approved*\n\n*Analysis ID:* `{{ $json.analysis_id }}`\n*Confidence:* {{ $json.confidence_score }}/10 _(threshold: 8.5)_\n\nThis report exceeded the confidence threshold and has been automatically distributed.\n\n<{{ $json.report_url }}|View Full Report>",
        "otherOptions": {
          "mrkdwn": true
        }
      },
      "id": "slack-auto-approved",
      "name": "Slack: Auto-Approved Notice",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [900, 160],
      "credentials": {
        "slackApi": {
          "id": "slack-credential",
          "name": "Slack ASIS Bot"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $env.SLACK_APPROVAL_CHANNEL_ID }}",
          "mode": "id"
        },
        "text": ":hourglass_flowing_sand: *ASIS Report Requires Human Approval*\n\n*Analysis ID:* `{{ $json.analysis_id }}`\n*Confidence:* {{ $json.confidence_score }}/10 _(below 8.5 threshold — manual review required)_\n\n*Executive Summary:*\n{{ $json.executive_summary.substring(0, 500) }}...\n\n*Recommendation:*\n{{ $json.recommendation }}\n\n<{{ $json.report_url }}|View Full Report>\n\nPlease approve or reject this report:",
        "otherOptions": {
          "mrkdwn": true
        },
        "blocksUi": {
          "blocksValues": [
            {
              "type": "actions",
              "blockId": "approval_actions",
              "elements": [
                {
                  "type": "button",
                  "text": "Approve",
                  "style": "primary",
                  "actionId": "approve_report",
                  "value": "={{ $json.analysis_id }}"
                },
                {
                  "type": "button",
                  "text": "Reject",
                  "style": "danger",
                  "actionId": "reject_report",
                  "value": "={{ $json.analysis_id }}"
                }
              ]
            }
          ]
        }
      },
      "id": "slack-request-approval",
      "name": "Slack: Request Approval",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [900, 400],
      "credentials": {
        "slackApi": {
          "id": "slack-credential",
          "name": "Slack ASIS Bot"
        }
      }
    },
    {
      "parameters": {
        "resume": "webhook",
        "webhookSuffix": "approval-response-{{ $json.analysis_id }}",
        "options": {
          "webhookDescription": "Wait for Slack approval or rejection",
          "limitWaitTime": true,
          "limitType": "afterTimeInterval",
          "resumeAmount": 24,
          "resumeUnit": "hours"
        }
      },
      "id": "wait-for-approval",
      "name": "Wait for Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "check-approved",
              "leftValue": "={{ $json.body.action || $json.action }}",
              "rightValue": "approve_report",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-decision",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 400]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $env.SLACK_APPROVAL_CHANNEL_ID }}",
          "mode": "id"
        },
        "text": ":white_check_mark: Report `{{ $json.analysis_id }}` has been *APPROVED* and distributed.",
        "otherOptions": {}
      },
      "id": "slack-approved",
      "name": "Slack: Approved",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1560, 300],
      "credentials": {
        "slackApi": {
          "id": "slack-credential",
          "name": "Slack ASIS Bot"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $env.SLACK_APPROVAL_CHANNEL_ID }}",
          "mode": "id"
        },
        "text": ":x: Report `{{ $json.analysis_id }}` has been *REJECTED*. No distribution will occur.",
        "otherOptions": {}
      },
      "id": "slack-rejected",
      "name": "Slack: Rejected",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1560, 500],
      "credentials": {
        "slackApi": {
          "id": "slack-credential",
          "name": "Slack ASIS Bot"
        }
      }
    }
  ],
  "connections": {
    "ASIS Completion Trigger": {
      "main": [
        [
          {
            "node": "Extract Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Fields": {
      "main": [
        [
          {
            "node": "Confidence > 8.5?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Confidence > 8.5?": {
      "main": [
        [
          {
            "node": "Slack: Auto-Approved Notice",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Slack: Request Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack: Request Approval": {
      "main": [
        [
          {
            "node": "Wait for Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for Approval": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Slack: Approved",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Slack: Rejected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "tags": [
    {
      "createdAt": "2024-01-01T00:00:00.000Z",
      "updatedAt": "2024-01-01T00:00:00.000Z",
      "id": "asis-approval",
      "name": "asis-approval"
    }
  ],
  "triggerCount": 0,
  "updatedAt": "2024-01-01T00:00:00.000Z",
  "versionId": "v3.0.0"
}
